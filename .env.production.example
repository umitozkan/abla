# Hedef: 207.180.223.77 / https://abla.umitozkan.com.tr
# Önerilen ilk kurulum: python3 scripts/setup_env.py --production
# Bu komut .env dosyasını rastgele sırlarla ve 600 izniyle oluşturur.
# Mevcut .env dosyasının veya sembolik bağlantının üzerine yazmaz.
COMPOSE_PROJECT_NAME=abla
APP_ENV=production
APP_PORT=18082
ALLOWED_HOSTS=abla.umitozkan.com.tr,localhost,127.0.0.1
COOKIE_SECURE=true

# Elle kurulumda bu üç alanı birbirinden farklı rastgele değerlerle doldurun.
# SECRET_KEY: en az 32 karakter. Parolalar: en az 12 karakter.
# Gerçek .env dosyasını Git'e eklemeyin veya paylaşmayın.
SECRET_KEY=
ADMIN_USERNAME=yonetici
ADMIN_PASSWORD=
EMINE_USERNAME=emine
EMINE_PASSWORD=

# DATA_DIR=/data ve TZ=Europe/Istanbul compose.yaml içinde tanımlıdır.
# Kullanıcılar yalnızca boş veritabanındaki ilk açılışta oluşturulur.
# Bu dosyayı değiştirmek mevcut kullanıcıların parolalarını değiştirmez.
