# Yerel HTTP denemesi. Üretimde APP_ENV=production ve COOKIE_SECURE=true yapın.
APP_ENV=development
APP_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1,abla.umitozkan.com.tr
COOKIE_SECURE=false

# Boş değerleri, birbirinden farklı rastgele değerlerle doldurun. Varsayılan şifre yoktur.
# SECRET_KEY: en az 32 karakter; openssl rand -hex 32 ile üretilebilir.
SECRET_KEY=
ADMIN_USERNAME=yonetici
ADMIN_PASSWORD=
EMINE_USERNAME=emine
EMINE_PASSWORD=
